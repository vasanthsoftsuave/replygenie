<resources>
    <!--
      Only used for the window before Compose draws. Real theming lives in
      ui/theme/Theme.kt, which is driven by the user's saved settings.
      The background matches the dark palette so there is no white flash on launch.
    -->
    <style name="Theme.RephraseGenie" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
