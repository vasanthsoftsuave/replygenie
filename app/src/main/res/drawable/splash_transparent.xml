<?xml version="1.0" encoding="utf-8"?>
<!--
  A deliberately invisible icon for the Android 12+ system splash.

  That splash cannot be turned off, and it cannot be made shorter: the system draws it from the
  moment the process starts until our first frame. What it can be is unnoticeable. With the icon
  transparent and the splash background the same colour as the intro video's letterbox, the launch
  reads as the video starting rather than as an icon flashing and then being replaced.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
