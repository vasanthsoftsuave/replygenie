<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept to the minimum the feature needs: window changes, so the bubble can step aside in apps on
  the blocked list, and the ability to read and set the focused field's text when the user taps.

  Focus and text-selection events are deliberately not requested. The bubble used to follow the
  focused field, which meant waking this service for every keystroke in every app; it now sits
  where the user puts it and reads the field once, at the moment of the tap.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_summary" />
