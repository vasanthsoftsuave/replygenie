<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Lets the blocked-apps picker list the apps the user can actually open.
      Deliberately NOT QUERY_ALL_PACKAGES, which is restricted and gets apps rejected.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".RephraseGenieApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RephraseGenie">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RephraseGenie"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Watches focus, reads the focused field and writes the result back. It also draws the
          bubble itself, as a TYPE_APPLICATION_OVERLAY window, which is why SYSTEM_ALERT_WINDOW is
          declared above. TYPE_ACCESSIBILITY_OVERLAY looked like a way to avoid that second
          permission, but addView throws no error and creates no window.
        -->
        <service
            android:name=".overlay.RephraseAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
